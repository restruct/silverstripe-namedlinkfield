{
    "name": "restruct/silverstripe-namedlinkfield",
    "description": "A Silverstripe link field with its own title: link to a page (with an optional anchor), a file, a URL, an e-mail address or a shortcode, stored in one composite database field.",
    "keywords": [
        "silverstripe",
        "silverstripe-module",
        "silverstripe-cms",
        "link-field",
        "form-field"
    ],
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/vendor-plugin": "^3",
        "silverstripe/framework": "^6",
        "sheadawson/silverstripe-dependentdropdownfield": "^4"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\SilverStripe\\Forms\\": "src/",
            "Restruct\\SilverStripe\\ORM\\FieldType\\": "src/",
            "Restruct\\SilverStripe\\NamedLinkField\\": "src/"
        }
    },
    "extra": {
        "installer-name": "namedlinkfield",
        "expose": [
            "client"
        ]
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^4"
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\NamedLink\\Tests\\": "tests/"
        }
    }
}